    "check:fix": "biome check --write .",
    "audit": "pnpm audit --prod",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
